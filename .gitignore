# Scratch files stages write while assembling subagent input
*.tmp
*.tmp.json
.tmp/
__pycache__/
*.pyc

# Local overrides — keep API keys out of the repo. Provide FMP_API_KEY /
# FINNHUB_API_KEY through the environment's variables instead.
.env
.claude/settings.local.json

# Filing bodies rehydrated from EDGAR on demand. capture.py stores pointers
# only — bodies were ~99% of an event's bytes and EDGAR is immutable, so this
# is a local cache, never corpus state. scripts/rehydrate.py rebuilds it.
backtest/captures/events/*/filings_text/

# Price bars cached by dashboard/build_ledger.py. Pure cache:
# delete it and the next build refetches.
.cache/

# Stage AU's ASIC short-register cache. Deliberately NOT committed, where
# researcher_japan/analysis/short-positions-cache.json IS: JPX's window rolls, so once a
# day drops off its index that file is the only record of it and losing it loses the
# data. ASIC keeps 4,113 dated files back to 2010-06-16, so this cache is a convenience
# that re-fetches on demand, and committing a file that grows 280KB every run would
# bloat the repo for nothing.
researcher_australia/analysis/short-positions-cache.json
