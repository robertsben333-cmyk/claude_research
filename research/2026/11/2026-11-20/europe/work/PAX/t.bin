0 _9srqtxv\",\"style\":{\"fontWeight\":\"$undefined\"},\"children\":\"Page Not Found\"}],[\"$\",\"h3\",null,{\"className\":\"_9srqtx2 _9srqtxv m7dlscj\",\"style\":{\"fontWeight\":\"$undefined\"},\"children\":\"Sorry, the page you are looking for does not exist.\"}],[\"$\",\"a\",null,{\"href\":\"/\",\"className\":\"wy4fk30 wy4fk34 wy4fk37\",\"rel\":\"$undefined\",\"target\":\"$undefined\",\"children\":[\"$undefined\",[\"$\",\"p\",null,{\"className\":\"_9srqtxc _9srqtx16\",\"style\":{\"fontWeight\":\"$undefined\"},\"children\":\"Go to Home\"}],\"$undefined\"]}]]}],\"notFoundStyles\":[[\"$\",\"link\",\"0\",{\"rel\":\"stylesheet\",\"href\":\"/_next/static/css/d4482eb14bd99d43.css\",\"precedence\":\"next\",\"crossOrigin\":\"$undefined\"}]]}]]}]}]]}]}]}]]}],[\"$\",\"$L2b\",null,{\"gaId\":\"G-PSHTH8ESK6\"}]]}]\n"])</script><script>self.__next_f.push([1,"2d:I[28538,[\"1151\",\"static/chunks/1151-92d1e96c312892c9.js\",\"2769\",\"static/chunks/2769-14f02c0a4aa87366.js\",\"3545\",\"static/chunks/3545-494c85495cdf3563.js\",\"9755\",\"static/chunks/9755-415c6f15a907a32d.js\",\"7397\",\"static/chunks/7397-195a6d8fddcc387a.js\",\"7097\",\"static/chunks/7097-943a54d728f899ea.js\",\"8514\",\"static/chunks/8514-6ae754fac7941abc.js\",\"5516\",\"static/chunks/app/publication/%5BpublicationId%5D/page-36adce79690799d1.js\"],\"Publication\"]\n2c:T8b8,"])</script><script>self.__next_f.push([1,"\u003cstrong\u003eWe forecast Q3 net sales of SEK105m (up 21% Y/Y) and EBITDA of SEK16m, corresponding to a 15% margin. This implies broadly flat sequential sales versus the strong Q2, and normalising growth as the Dignitana acquisition is fully annualised in the comparable base. Despite cutting our 2026e EBITDA by 21%, we maintain our longer-term growth and margin assumptions. Following peer multiple and model updates, we adjust our fair value range to SEK72–106 (71–106) per share.\u003c/strong\u003e\u003cbr /\u003e\u003cbr /\u003eWe expect Q3 to show continued revenue growth of 21% Y/Y. The key operational question in our view is whether the stronger insurance-based billing model (IBBM) traction in Q2 (in utilisation, cap volumes and system orders) was sustained in Q3. We believe the H2 revenue bridge remains well underpinned by the order book and expected contribution from the five OneOncology practices from Q4, although quarterly developments may remain lumpy.\u003cbr /\u003e\u003cbr /\u003eMargins remain the key swing factor. We forecast a Q3 gross margin of 66%, EBITDA of SEK16m and EBIT of SEK10m, corresponding to 15% and 10% margins, respectively. While our EBITDA estimate represents a significant improvement from Q2 2025 (+c100%), it is below our previous expectation (we lower our Q3 2026–Q1 2027e EBITDA by SEK2m–9m, reflecting an elevated opex base for longer). This partly reflects continued chemotherapy-induced peripheral neuropathy (CIPN) engagement and associated launch-preparation costs, while the Q2 result also showed the cost base was increasing Y/Y.\u003cbr /\u003e\u003cbr /\u003eEurope first for CIPN, while the US is a 2027e event. Following the FDA’s shift to a De Novo pathway, we expect European commercialisation from late-Q4 2026 and a US launch around Q2–Q3 2027. We continue to assume no material CIPN revenue in our estimates.\u003cbr /\u003e\u003cbr /\u003eWe believe the most important data points will be continued IBBM site growth, but also cap volumes and utilisation, alongside the development in the opex base. We continue to see a solid fundamental story in Paxman. Our estimates suggest a 2027 EV/EBITDA of c10x, versus a peer median of c12x. Our forecast revisions and peer multiples lead to a minor update to our fair value range to SEK72–106 per share."])</script><script>self.__next_f.push([1,"18:[\"$\",\"$L24\",null,{\"state\":{\"mutations\":[],\"queries\":[{\"state\":{\"data\":{\"items\":[{\"publicationId\":\"6a91f8d2-6073-4d86-5468-08df2f5ed3b0\",\"publishedAt\":\"2026-10-22T06:34:00\",\"headline\":\"IBBM momentum versus opex - Q3 p