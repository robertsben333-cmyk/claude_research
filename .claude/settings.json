{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash",
      "Read",
      "Write",
      "Edit",
      "Glob",
      "Grep",
      "WebSearch",
      "WebFetch",
      "Task",
      "NotebookEdit",
      "TodoWrite",
      "Bash(python3 researcher_us/scripts/alpaca_trade.py:*)",
      "Bash(python3 scripts/alpaca_trade.py:*)",
      "Bash(python3 edge/scripts/alpaca_trade.py:*)",
      "Bash(python3 researcher_us/scripts/edge_universe.py:*)",
      "Bash(python3 scripts/edge_universe.py:*)",
      "Bash(python3 edge/scripts/edge_universe.py:*)"
    ],
    "deny": [
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git push --force-with-lease:*)",
      "Bash(git reset --hard:*)",
      "Bash(git clean -fd:*)",
      "Bash(git checkout --force:*)",
      "Bash(rm -rf:*)",
      "Bash(rm -fr:*)"
    ]
  },
  "env": {
    "CLAUDE_CODE_MAX_CONCURRENT_SUBAGENTS": "8"
  }
}
