{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(python3 scripts/get_earnings.py:*)",
      "Bash(python3 scripts/run_paths.py:*)",
      "Bash(python3 scripts/synthesize.py:*)",
      "Bash(python3 scripts/update_index.py:*)",
      "Bash(python3 scripts/validate_stage.py:*)",
      "Bash(scripts/publish.sh:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git fetch:*)",
      "Bash(git pull:*)",
      "Bash(git push:*)",
      "Bash(git checkout:*)",
      "Bash(mkdir:*)",
      "WebSearch",
      "WebFetch",
      "Read",
      "Glob",
      "Grep"
    ],
    "deny": [
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git reset --hard:*)",
      "Bash(rm -rf:*)"
    ]
  },
  "env": {
    "CLAUDE_CODE_MAX_CONCURRENT_SUBAGENTS": "8"
  }
}
